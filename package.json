{
  "name": "say-it-remotion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Lesson-FR out/lesson-fr.mp4",
    "lesson": "node --env-file=.env scripts/build-lesson.mjs",
    "lesson:script": "node --env-file=.env scripts/build-from-script.mjs",
    "lesson:sent": "node scripts/parse-sent.mjs curriculum/lesson-01.sent.md lesson-01 && node --env-file=.env scripts/build-from-script.mjs",
    "studio": "node --env-file=.env scripts/studio-server.mjs",
    "lessons": "node --env-file=.env scripts/pipeline/orchestrate.mjs",
    "lessons:test": "node --test test/pipeline.test.mjs",
    "audio": "node --env-file=.env scripts/generate-audio.mjs",
    "images:anchors": "node --env-file=.env scripts/generate-anchors.mjs",
    "images:style": "node --env-file=.env scripts/create-style.mjs",
    "images": "node --env-file=.env scripts/generate-images.mjs",
    "upgrade": "remotion upgrade",
    "qa": "node scripts/qa/all.mjs",
    "qa:manifest": "node scripts/qa/manifest.mjs",
    "qa:gate-a": "node scripts/qa/gate-a.mjs",
    "qa:asr": "node scripts/qa/asr.mjs",
    "qa:pauses": "node scripts/qa/gate-b-pauses.mjs",
    "qa:wpm": "node scripts/qa/gate-b-wpm.mjs",
    "qa:pron": "node scripts/qa/gate-b-pronunciation.mjs",
    "qa:av": "node scripts/qa/gate-b-av-sync.mjs",
    "qa:gate-a-legacy": "node scripts/qa/gate-a-curriculum.mjs",
    "qa:gate-b": "node scripts/qa/gate-b.mjs",
    "qa:technical": "node scripts/qa/gate-b-technical.mjs",
    "qa:i05": "node scripts/qa/gate-b-i05.mjs",
    "qa:rate": "node scripts/qa/gate-b-rate.mjs",
    "qa:s08": "node scripts/qa/gate-b-audio-identity.mjs",
    "qa:i08": "node scripts/qa/gate-b-i08.mjs",
    "qa:author": "node scripts/qa/author.mjs",
    "qa:pbeat": "node scripts/qa/pbeat.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "@remotion/google-fonts": "^4.0.484",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.484",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}
